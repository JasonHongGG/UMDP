# Shared diagnostics configuration for both Vite frontend and Rust backend.
# Copy this file to `.env` and change the values as needed.

UNITY_MONO_STUDIO_DEBUG_DIAGNOSTICS=false
UNITY_MONO_STUDIO_DEBUG_DIAGNOSTICS_LEVEL=debug
UNITY_MONO_STUDIO_DEBUG_DIAGNOSTICS_CHANNELS=
UNITY_MONO_STUDIO_DEBUG_DIAGNOSTICS_ORIGINS=
UNITY_MONO_STUDIO_DEBUG_DIAGNOSTICS_CONSOLE=true
UNITY_MONO_STUDIO_DEBUG_DIAGNOSTICS_BUFFER=true
UNITY_MONO_STUDIO_DEBUG_DIAGNOSTICS_MAX_BUFFER=200